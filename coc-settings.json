{
    "codeLens.enable": true,
    "diagnostic.virtualText": true,
    "rust-analyzer.checkOnSave.command": "clippy",
    "coc.preferences.extensionUpdateCheck": "daily",

    "languageserver": {
        "coc-clangd": {
            "command": "clangd",
            "rootPatterns": [
                "build/ninja/compile_commands.json",
                "compile_flags.txt"
            ],
            "filetypes": [
                "c",
                "cc",
                "cpp",
                "c++",
                "objc",
                "objcpp"
            ],
            "initializationOptions": {
            }
        }
    }
}
